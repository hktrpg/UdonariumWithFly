  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "jasmine",
      "hammerjs"
    ]
  },
  "files": [
    "src/app/class/core/file-storage/fs-access.d.ts"
